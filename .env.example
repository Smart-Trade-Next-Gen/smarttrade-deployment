# Authentication & Security
JWT_SECRET_KEY=your-secret-key-here-min-32-chars
TOKEN_ENCRYPTION_KEY=your-encryption-key-here-base64

# Broker Configuration
FYERS_APP_ID=your-fyers-app-id
FYERS_APP_SECRET=your-fyers-app-secret

# Logging
LOG_LEVEL=INFO

# Environment
ENV=local

# ─────────────────────────────
# Redis Configuration
# ─────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Event Bus
EVENT_BUS=redis

# Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting

# Database (auto-generated from service names in docker-compose)
# AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/smarttrade_authentication_service
# BAS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/smarttrade_broker_adapter_service
# MDS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/smarttrade_market_data_service
# PBS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/smarttrade_paper_broker_service

# Broker Redirect
BROKER_REDIRECT_URI=http://www.smarttrade.asia/

# Risk Management
RISK_VALIDATION_ENABLED=true

# Internal Service URLs
BROKER_ADAPTER_SERVICE_URL=http://broker-adapter-service:8000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Python Environment
UV_PROJECT_ENVIRONMENT=/opt/venv
UV_INDEX_URL=https://pypi.org/simple
UV_LINK_MODE=copy
