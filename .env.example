# Authentication & Security
JWT_SECRET_KEY=your-secret-key-here-min-32-chars
TOKEN_ENCRYPTION_KEY=your-encryption-key-here-base64

# Broker Configuration
FYERS_APP_ID=your-fyers-app-id
FYERS_APP_SECRET=your-fyers-app-secret

# Market Data Service (MDS) - Fyers DataSocket credentials
FYERS_MDS_APP_ID=your-fyers-mds-app-id
FYERS_MDS_APP_SECRET=your-fyers-mds-app-secret

# Logging
LOG_LEVEL=INFO

# Environment
ENV=local

# ─────────────────────────────
# Redis Configuration
# ─────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting

# Database (auto-generated from service names in docker-compose)
# AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/smarttrade_authentication_service
# BAS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/smarttrade_broker_adapter_service
# MDS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/smarttrade_market_data_service
# PBS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/smarttrade_paper_broker_service

# Broker Redirect
BROKER_REDIRECT_URI=http://www.smarttrade.asia/

# Risk Management
RISK_VALIDATION_ENABLED=true

# Internal Service URLs
BROKER_ADAPTER_SERVICE_URL=http://broker-adapter-service:8000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Python Environment
UV_PROJECT_ENVIRONMENT=/opt/venv
UV_INDEX_URL=https://pypi.org/simple
UV_LINK_MODE=copy

# Research Agent (docker compose --profile agents up research-agent)
# Account used to fetch packages + submit analysis (needs research.compute)
RESEARCH_AGENT_USERNAME=
RESEARCH_AGENT_PASSWORD=
# Optional static JWT instead of login (expires; prefer credentials)
# RESEARCH_AGENT_TOKEN=
# Host path to the Devin CLI extension dir (binary + bundled resources)
# DEVIN_EXT_DIR=/usr/share/devin-desktop/resources/app/extensions/windsurf/devin
# Cadence of the pending-entry sweep that retries unsettled triggers
# RESEARCH_AGENT_RECLAIM_SECONDS=300
# RESEARCH_AGENT_TIMEOUT_SECONDS=3600
# RESEARCH_AGENT_MAX_ATTEMPTS=2
# Cooldown before a republished trigger gets a fresh attempt budget
# RESEARCH_AGENT_RETRY_COOLDOWN_SECONDS=3600
# Concurrent headless Devin sessions (each is a full agent run —
# N workers multiply credit burn by ~N while active)
# RESEARCH_AGENT_MAX_PARALLEL=4
# DEVIN_PERMISSION_MODE=dangerous
# Reasoning effort is part of the model name: swe-2-low/-high/-max
# DEVIN_MODEL=swe-2-high
# Devin auth for headless agent sessions — API key (simplest) OR a
# one-time `devin auth login` on the host (credentials.toml is mounted)
# WINDSURF_API_KEY=

# AI Scoring — parked-run re-announce sweep (republishes
# awaiting_analysis for runs parked > MIN_AGE; keeps lost triggers
# from stranding runs when the agent consumes Redis events only)
# RESEARCH_REPUBLISH_INTERVAL_SECONDS=300
# RESEARCH_REPUBLISH_MIN_AGE_SECONDS=900
